// Zed settings: tuned for reviewing git diffs and navigating files, with VS Code keybindings
// Full defaults: command palette -> "zed: open default settings"
{
  // ---- Behavior ----
  "cursor_animation": {
    "enabled": true
  },
  "text_rendering_mode": "platform_default",
  "proxy": "",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "fast": false
      },
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "vim_mode": false,
  "restore_on_startup": "last_session",
  // Save on focus change so format_on_save doesn't reflow code mid-typing
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "tab_size": 2,

  // ---- Appearance (matches kitty) ----
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte (Blur 2.0)",
    "dark": "Catppuccin Mocha (Blur 2.0)"
  },
  "icon_theme": "Catppuccin Mocha",
  // Catppuccin Blur 2.0 (themes/catppuccin-blur-2.json): official Catppuccin with frosted
  // glass, one theme per flavor, text contrast checked over dark and bright wallpapers.
  // Generated by ~/dotfiles/zed/build-catppuccin-blur-2.py; edit that, not the JSON.
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "biome": true
  },
  // Fonts and terminal behavior mirror kitty.conf / font.conf
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_fallbacks": ["Maple Mono NF CN"],
  "buffer_font_size": 14,
  "buffer_line_height": "comfortable",
  "ui_font_size": 15,
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_fallbacks": ["Maple Mono NF CN"],
    "font_size": 14,
    "line_height": "standard",
    "blinking": "off",
    "copy_on_select": true,
    "option_as_meta": true
  },
  "cursor_blink": false,
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false
  },
  "collaboration_panel": {
    "button": false
  },

  // ---- Layout: project + git panels on the left, agent on the right ----
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "auto_reveal_entries": true
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "agent": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },

  // ---- Navigation ----
  "file_finder": {
    "modal_max_width": "large"
  },
  "tabs": {
    "git_status": true,
    "file_icons": true
  },

  // ---- Git ----
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
      "show_commit_summary": true
    }
  },

  // ---- Languages ----
  // Python defaults to basedpyright + ruff (format, organize imports); Zed downloads them
  // Go defaults to gofmt with hard tabs; Markdown soft-wraps by default
  "languages": {
    "Python": {
      "tab_size": 4
    },
    // ESLint off for JS/TS; Biome lints, formats, fixes and organizes imports.
    // typescript-language-server stays off as in Zed's defaults (listing servers
    // replaces the default list, and "..." would otherwise re-enable it)
    "TypeScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "!eslint", "..."],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "!eslint", "..."],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JavaScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "!eslint", "..."],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    }
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
